# Kuwait Travel & Tourism - Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN REAL VALUES. DO NOT COMMIT .env TO VERSION CONTROL.

# Server Port
PORT=5000

# Frontend origin allowed by CORS (defaults to http://localhost:5173 for Vite dev)
FRONTEND_ORIGIN=http://localhost:5173

# JWT Signing Secret (Required for server-side session authentication)
# Generate with: node -e "require('crypto').randomBytes(64).toString('hex')"
# Never commit a real value. Minimum 32 characters recommended.
JWT_SECRET=your_jwt_secret_here

# Google Cloud & Gemini API Key (Required for AI assistant, Voice assistant, TTS)
# Obtain from https://aistudio.google.com/
GOOGLE_API_KEY=your_google_api_key_here

# Google OAuth Client ID (Required for Google Single Sign-On)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Google Cloud Text-to-Speech API Key (Optional; falls back to GOOGLE_API_KEY if unset)
GOOGLE_TTS_API_KEY=your_google_tts_api_key_here

# Optional Cloud LLM Providers (for LangChain AIService)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional Custom / Local AI Endpoint (Ollama or custom OpenAI-compatible endpoint)
CUSTOM_API_URL=http://127.0.0.1:11434
CUSTOM_API_KEY=

# Optional Third-Party TTS Providers (PlayHT)
PLAYHT_API_KEY=your_playht_api_key_here
PLAYHT_USER_ID=your_playht_user_id_here

# PostgreSQL Database Configuration (Optional / Legacy connection settings)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kuwait_travel
DB_USER=postgres
DB_PASSWORD=
